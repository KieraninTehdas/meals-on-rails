<%= form_with(model: meal_plan, class: "flex flex-col") do |form| %>
  <% if meal_plan.errors.any? %>
    <div id="error_explanation">
      <ul class="">
        <% meal_plan.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="flex flex-col my-4">
    <div class="flex sm:flex-row flex-col my-2">
    <div class="sm:pr-4 sm:my-0 my-2">
      <div class="pb-2">
        <span>
          <%= form.label :start_date %>
        </span>
      </div>
      <input type="date" id="meal_plan_start_date" name="meal_plan[start_date]" value="<%= meal_plan.start_date || Date.today %>"/>
    </div>

    <div class="sm:pl-4 sm:my-0 my-2">
      <div class="pb-2">
        <span>
          <%= form.label :end_date %>
        </span>
      </div>
      <input type="date" id="meal_plan_end_date" name="meal_plan[end_date]" value="<%= 6.days.after(Date.today) %>"/>
    </div>
    </div>

    <div class="flex flex-col my-2">
      <div data-controller="recipe-selector">
        <div class="mb-4">
          <label for="recipe-search-input" class="block text-sm font-medium mb-2">Search Recipes</label>
          <%= text_field_tag("recipe-search-input", "", placeholder: "Search by name or label", data: { controller: "form-submit", "form-submit-url-value": search_recipes_path, "form-submit-frame-id-value": "recipe-options", action: "input->form-submit#handleSubmit"}) %>
          <turbo-frame id="recipe-options"></turbo-frame>
        </div>

        <div class="mb-4">
          <label class="block text-sm font-medium mb-2">Selected Recipes</label>
          <div id="selected-recipes" data-recipe-selector-target="selectedList" class="border rounded p-3 min-h-20">
            <% if meal_plan.recipe_ids.any? %>
              <% meal_plan.recipes.each do |recipe| %>
                <%= render "meal_plans/selected_recipe", recipe: recipe %>
              <% end %>
            <% else %>
              <p class="text-gray-500">No recipes selected</p>
            <% end %>
          </div>
          <%= form.hidden_field :recipe_ids, value: meal_plan.recipe_ids.join(","), id: "recipe-ids-input", data: { "recipe-selector-target": "recipeInput" } %>
        </div>
      </div>
    </div>
  </fieldset>

  <fieldset class="flex flex-col gap-y-2 my-4">
    <div class="flex gap-x-2">
      <%= form.button @meal_plan.new_record? ? "New meal plan" : "Save", class: primary_button_classes %>
      <%= button_to 'Back', meal_plans_path, :secondary%>
    </div>

    <div>
      <% unless @meal_plan.new_record? %>
        <%= button_to "Delete",
          @meal_plan,
          :tertiary,
          method: :delete,
          data: { turbo_confirm: "Are you sure?", turbo_method: :delete }
        %>
      <% end %>
    </div>
  </fieldset>
<% end %>
